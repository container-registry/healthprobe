---
extends: default

ignore: |
  node_modules/
  dist/
  .task/
  vendor/
  # Go template syntax is not valid YAML.
  /deploy/chart/templates/
  /deploy/chart/tests/__snapshot__/

rules:
  line-length: disable
  comments-indentation: disable
  # `on:` in a workflow is the trigger key, not the boolean true.
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  document-start: disable
  # release-please re-emits Chart.yaml's appVersion with one space before its marker.
  comments:
    min-spaces-from-content: 1
  braces:
    # Empty flow mappings are how `permissions: {}` denies every scope.
    min-spaces-inside: 0
    max-spaces-inside: 0
  indentation:
    spaces: consistent
    indent-sequences: consistent
